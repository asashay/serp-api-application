{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "serp-api-demo",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-11-23",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "serp-api-demo.alexoliynyk.me", "custom_domain": true }
  ],
  "vars": {
    "PUBLIC_ORIGIN": "https://serp-api-demo.alexoliynyk.me",
    "RENDERER_CONFIG_VERSION": "3"
  },
  "triggers": { "crons": [ "*/5 * * * *" ] },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false }
  },
  "durable_objects": {
    "bindings": [
      { "name": "SEARCH_GATE", "class_name": "SearchGate" },
      { "name": "RAILS", "class_name": "RailsContainer" }
    ]
  },
  "exports": {
    "SearchGate": { "type": "durable-object", "storage": "sqlite" },
    "RailsContainer": { "type": "durable-object", "storage": "sqlite" }
  },
  "containers": [
    {
      "class_name": "RailsContainer",
      "scheduling_policy": "durable_object",
      "images": { "base": { "dockerfile": "./Dockerfile" } },
      "observability": { "logs": { "enabled": true } }
    }
  ]
}
