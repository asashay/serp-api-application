<header class="site-header">
  <div class="shell masthead">
    <a class="brand" href="/" aria-label="Search Lab home"><span class="brand-mark" aria-hidden="true">&lt;/&gt;</span> Search Lab</a>
    <a class="source-link" href="https://github.com/asashay/serp-api-application">GitHub source</a>
  </div>
</header>

<main class="shell" data-controller="playground" data-playground-origin-value="<%= @api_origin %>">
  <section class="hero" aria-labelledby="page-title">
    <h1 id="page-title">Google Search API</h1>
    <p class="intro">Enter a LingoRep page path, such as /, to fetch it through the live renderer and see the structured JSON.</p>

    <form action="/search.json" method="get" class="search-form" data-action="submit->playground#search">
      <label for="query">Search query</label>
      <div class="search-row">
        <input id="query" name="q" type="search" value="<%= @query %>" required maxlength="400"
          autocomplete="off" data-playground-target="query" data-action="input->playground#updateIntegration">
        <button class="primary" type="submit" data-playground-target="submit">Run search</button>
      </div>
      <div class="form-status" role="status" aria-live="polite" data-playground-target="status"></div>
    </form>
  </section>

  <section class="comparison" aria-label="Search response" data-playground-target="comparison">
    <div class="comparison-header">
      <div class="response-status" aria-live="polite">
        <span class="response-tag" data-playground-target="source">Saved example</span>
        <span class="response-details" data-playground-target="summary"><%= pluralize(@sample.fetch(:headings).length, "heading") %></span>
      </div>
    </div>

    <section class="panel json-panel" aria-labelledby="heading-json">
      <header class="panel-header">
        <h2 id="heading-json">API response</h2>
        <button class="text-button" type="button" data-action="playground#copyJson">Copy JSON</button>
      </header>
      <pre tabindex="0" aria-label="Search response JSON"><code data-playground-target="json"><%= JSON.pretty_generate(@sample) %></code></pre>
    </section>
  </section>

  <section class="integration" aria-labelledby="integration-title">
    <header class="integration-header">
      <div>
        <h2 id="integration-title">Use the API</h2>
        <p>One live search every 10–15 seconds and 400 per month, shared across the demo.</p>
      </div>
      <a class="quiet-link" href="/example.json">Saved JSON</a>
    </header>
    <div class="endpoint">
      <span class="method">GET</span>
      <code data-playground-target="url"><%= @api_url %></code>
    </div>
    <div class="integration-actions">
      <a class="secondary" href="<%= @api_url %>" target="_blank" rel="noopener" data-playground-target="open">Open JSON</a>
      <button class="secondary" type="button" data-action="playground#copyUrl">Copy URL</button>
      <button class="secondary" type="button" data-action="playground#copyCurl">Copy curl</button>
      <span class="copy-status" role="status" aria-live="polite" data-playground-target="copyStatus"></span>
    </div>
  </section>
</main>
